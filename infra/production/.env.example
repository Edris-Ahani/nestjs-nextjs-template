API_IMAGE=ghcr.io/your-organization/nestjs-foundry-api@sha256:replace-with-published-digest
WEB_IMAGE=ghcr.io/your-organization/nestjs-foundry-web@sha256:replace-with-published-digest
MIGRATION_IMAGE=ghcr.io/your-organization/nestjs-foundry-migrate@sha256:replace-with-published-digest
DATABASE_PROVIDER=postgresql
DATABASE_POOL_SIZE=10
# Mount full credential-bearing URLs through these private files; never commit their contents.
DATABASE_URL_FILE=/run/platform-secrets/runtime-database-url
MIGRATION_URL_FILE=/run/platform-secrets/migration-database-url
OIDC_ISSUER_URI=https://identity.example.com/realms/platform
OIDC_JWK_SET_URI=https://identity.example.com/realms/platform/protocol/openid-connect/certs
OIDC_AUDIENCE=platform-api
