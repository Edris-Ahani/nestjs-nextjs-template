{
  "name": "@platform/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "architecture:check": "node scripts/architecture.mjs",
    "check": "npm run lint && npm run typecheck && npm run architecture:check",
    "test": "node --test scripts/architecture.test.mjs && vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/adapter-mariadb": "7.10.1",
    "@scalar/api-reference": "1.79.0",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "jose": "6.2.17",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.1",
    "@types/express": "5.0.5",
    "@types/node": "24.10.0",
    "@types/supertest": "6.0.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.14.0",
    "prisma": "7.10.1",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
